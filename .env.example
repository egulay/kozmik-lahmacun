# Copy with scripts/setup-env.sh. The script replaces all CHANGE_ME values.
COMPOSE_PROJECT_NAME=kozmik-lahmacun

POSTGRES_DB=kozmik
POSTGRES_USER=kozmik
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN_ID=CHANGE_ME
VAULT_BACKEND_TOKEN=CHANGE_ME
VAULT_EXECUTOR_TOKEN=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@kozmik.local
SMTP_FROM_DISPLAY_NAME="Kozmik Lahmacun"
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

KAFKA_PORT=9092

MINIO_ROOT_USER=kozmik
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_EXECUTOR_USER=kozmik-executor
MINIO_EXECUTOR_PASSWORD=CHANGE_ME
MINIO_INGEST_USER=kozmik-ingest
MINIO_INGEST_PASSWORD=CHANGE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kozmik-executor
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
SPARK_MAX_CONCURRENT_JOBS=4
EXECUTION_TIMEOUT_SECONDS=1800
EXECUTION_MAX_PREVIEW_ROWS=100
EXECUTION_DATASET_URI=
EXECUTION_DATASET_FORMAT=parquet
RETENTION_HARD_DELETE_CRON='0 0 0 * * *'
RETENTION_HARD_DELETE_DAYS=30

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME
DEMO_REPORTER_PASSWORD=Demo1234!
DEMO_SCIENTIST_PASSWORD=Demo1234!
DEMO_ADMIN_PASSWORD=Demo1234!
INTERNAL_API_KEY=CHANGE_ME
INGESTION_SYSTEM_KEYCLOAK_USER_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3
KAFKA_MESSAGE_SIGNING_KEY=CHANGE_ME
PYTHON_BASE_URL=http://localhost:8000
JAVA_BASE_URL=http://host.docker.internal:8080
EXECUTOR_PORT=8000
LLM_PROVIDER=LM_STUDIO
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-coder-30b-a3b-instruct
