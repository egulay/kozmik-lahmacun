# Kozmik Lahmacun deployment configuration.
# .env.example is the source template. scripts/setup-env.sh creates or normalizes
# the ignored local .env while preserving existing values and generating missing secrets.
# Never commit .env. Runtime secrets are copied into scoped Vault paths during startup.

# Compose identity
COMPOSE_PROJECT_NAME=kozmik-lahmacun

# PostgreSQL control-plane database. Port is bound to localhost for local tooling.
POSTGRES_DB=kozmik
POSTGRES_USER=kozmik
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# HashiCorp Vault local bootstrap. Tokens are disposable demo credentials, not
# production Vault authentication.
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN_ID=CHANGE_ME
VAULT_BACKEND_TOKEN=CHANGE_ME
VAULT_EXECUTOR_TOKEN=CHANGE_ME

# Redis stores opaque browser sessions and server-side OIDC token state.
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# Kafka event backbone. The signing key authenticates application messages.
KAFKA_PORT=9092
KAFKA_MESSAGE_SIGNING_KEY=CHANGE_ME

# MinIO local object storage. Root credentials are bootstrap-only. Executor and
# ingestion users receive scoped policies. MINIO_ACCESS_KEY/SECRET_KEY mirror the
# executor identity for bootstrap and are replaced by Vault values at runtime.
MINIO_ROOT_USER=kozmik
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_EXECUTOR_USER=kozmik-executor
MINIO_EXECUTOR_PASSWORD=CHANGE_ME
MINIO_INGEST_USER=kozmik-ingest
MINIO_INGEST_PASSWORD=CHANGE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kozmik-executor
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false

# Mailpit captures local account emails. SMTP credentials may be empty when
# authentication is disabled; protected production credentials belong in Vault.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@kozmik.local
SMTP_FROM_DISPLAY_NAME="Kozmik Lahmacun"
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Keycloak identity service and disposable clean-demo users.
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_PORT=8081
DEMO_REPORTER_PASSWORD=Demo1234!
DEMO_SCIENTIST_PASSWORD=Demo1234!
DEMO_ADMIN_PASSWORD=Demo1234!

# Internal service authentication and system-owned ingestion identity.
INTERNAL_API_KEY=CHANGE_ME
INGESTION_SYSTEM_KEYCLOAK_USER_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3

# Local service addresses and browser-facing ports.
BACKEND_PORT=8080
EXECUTOR_PORT=8000
FRONTEND_PORT=5173
PYTHON_BASE_URL=http://localhost:8000
JAVA_BASE_URL=http://host.docker.internal:8080

# Maximum simultaneous browser SSE subscriptions to any individual chat,
# execution, entity, or global ingestion stream. Connections are removed on
# completion, timeout, or transport error; this remains finite as a safety bound.
SSE_MAX_SUBSCRIBERS_PER_STREAM=10000

# Execution policy. Time values are seconds. SPARK_MAX_CONCURRENT_JOBS limits
# Kozmik jobs per executor process; it is separate from Spark cluster capacity.
# Structured Spark settings and the optional master live in executor/config/spark.yml.
# SPARK_DRIVER_MEMORY must remain an environment setting because it is applied before
# the Spark JVM starts. Deployment-specific SPARK_* variables may override the YAML.
SPARK_MAX_CONCURRENT_JOBS=4
EXECUTION_TIMEOUT_SECONDS=7200
EXECUTION_MAX_PREVIEW_ROWS=100
EXECUTION_DATASET_URI=
EXECUTION_DATASET_FORMAT=parquet
SPARK_DRIVER_MEMORY=8g
SPARK_DRIVER_MAX_RESULT_SIZE=512m
PYTHON_PLANNING_TIMEOUT_SECONDS=660
PYTHON_CLASSIFICATION_TIMEOUT_SECONDS=240
PYTHON_CHAT_STREAM_TIMEOUT_SECONDS=240
LLM_MAX_CONCURRENT_STRUCTURED_REQUESTS=1
# Optional cluster override examples:
# SPARK_MASTER=spark://spark-master.internal:7077
# SPARK_EXECUTOR_MEMORY=8g
# SPARK_EXECUTOR_CORES=4
# SPARK_DYNAMIC_ALLOCATION_ENABLED=true

# LLM provider. LM Studio is the local default. For OpenAI-compatible operation,
# set LLM_PROVIDER=OPENAI_COMPATIBLE, use https://api.openai.com/v1, select an
# account-accessible model, and export OPENAI_COMPATIBLE_API_KEY in the launching shell.
# The API key is written to Vault and is intentionally never stored in this file.
LLM_PROVIDER=LM_STUDIO
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3-coder-30b-a3b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_MESSAGES=20
LLM_MAX_CONTEXT_CHARACTERS=12000
# OpenAI-compatible example:
# LLM_PROVIDER=OPENAI_COMPATIBLE
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-terra

# Retention. Cron expressions are quoted to remain valid dotenv values.
# Soft-deleted and expired records are permanently removed after the configured period.
RETENTION_CRON='0 17 2 * * *'
RETENTION_HARD_DELETE_CRON='0 0 0 * * *'
RETENTION_HARD_DELETE_DAYS=30
RETENTION_CHAT_DAYS=30
RETENTION_PREVIEW_DAYS=30
RETENTION_ARTIFACT_DAYS=90
RETENTION_EXECUTION_DAYS=90

# Daily filesystem logging and rolling retention.
JAVA_LOG_DIR=logs/java
PYTHON_LOG_DIR=logs/python
LOG_LEVEL=INFO
PYTHON_LOG_LEVEL=INFO
LOG_MAX_HISTORY_DAYS=90
LOG_TOTAL_SIZE_CAP=2GB
