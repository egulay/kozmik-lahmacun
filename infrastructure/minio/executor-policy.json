{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::raw",
        "arn:aws:s3:::refined",
        "arn:aws:s3:::results",
        "arn:aws:s3:::models"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::raw/*", "arn:aws:s3:::refined/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::refined/*",
        "arn:aws:s3:::results/*",
        "arn:aws:s3:::models/*"
      ]
    }
  ]
}
